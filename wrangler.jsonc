{
  "name": "voe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recepcao-onda-db",
      "database_id": "1adf8ea9-9efe-4a13-9bae-201723d34eca",
      "migrations_dir": "migrations"
    }
  ]
}
